# VenturePilot AI Environment Variables

# Server & Runtime
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# Database (SQLite embedded storage; managed by versioned migrations)
DATABASE_PATH="./data/venturepilot.db"

# Authentication & Security (Set strong random values in production)
SECRET_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
REFRESH_SECRET_KEY="CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI / LLM Configuration (Phase 2+ - Free-tier Flash & Embeddings)
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"
GEMINI_API_KEY=""

# Sonar Research API (Perplexity - Phase 2+)
SONAR_API_KEY=""

# Embeddings Model (Phase 2+ - auto-falls back to local-hash-256 if unavailable)
EMBEDDING_MODEL="gemini-embedding-001"

# Payments - Razorpay INR (Phase 6)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email / SMTP (Optional - for password reset & contact notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@venturepilot.local"

# Dev-only flags (ALLOW_UNPAID_REPORTS=true for Phase 2 testing; set to false in Phase 6 production)
ALLOW_UNPAID_REPORTS="true"
DEMO_MODE="false"
